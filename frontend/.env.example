# Frontend environment variables.
# Copy to `.env.local` (git-ignored via *.local) and adjust per environment.
#
# Base URL for backend API calls.
# - Leave empty for same-origin setups (Vite dev proxy locally, nginx in prod).
# - Set to a full origin (e.g. https://api.example.com) when the frontend is
#   served from a different origin than the backend.
VITE_API_BASE_URL=
